---
// 過ごし方プラン一覧ページ
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import { allStayPlans } from '../../data/schedules';
import EnjoyPlanCards from '../../components/ui/EnjoyPlanCards.astro';

// カードは TOP と同じ意匠。topPageDisplay（画像・縦書きタイトル）を持つものだけ出す
const cardPlans = allStayPlans
  .filter((plan) => plan.topPageDisplay)
  .sort(
    (a, b) =>
      (a.topPageDisplay?.displayOrder || 0) -
      (b.topPageDisplay?.displayOrder || 0)
  );

// ページ固有のクラス名
const pageClass = 'main-content--enjoy-index';
---

<BaseLayout pageTitle="過ごし方" pageClass={pageClass}>
  <!-- ヒーローセクション -->
  <section class="enjoy-hero">
    <div class="enjoy-hero__content">
      <h1 class="enjoy-hero__title">
        <span class="enjoy-hero__title-en">ENJOY</span>
        <span class="enjoy-hero__title-ja">過ごし方</span>
      </h1>
      <p class="enjoy-hero__description">
        富士山と西湖の美しい自然の中で、<br />
        様々な過ごし方プランをご提案します。
      </p>
    </div>
  </section>

  <!-- プラン一覧 -->
  <section class="enjoy-plans">
    <div class="enjoy-plans__container">
      <h2 class="enjoy-plans__heading js-fade-in-up">過ごし方プラン</h2>
    </div>
    {/* カードはTOPと同じ意匠で、右端まで伸びる。中央寄せのコンテナの外に出す */}
    <EnjoyPlanCards plans={cardPlans} />
  </section>

  <!-- パンくずリスト -->
  <div class="breadcrumb-wrapper">
    <Breadcrumb items={[{ text: 'TOP', href: '/' }, { text: '過ごし方' }]} />
  </div>
</BaseLayout>

<style lang="scss">
  @import '../../styles/variables';
  @import '../../styles/functions';
  @import '../../styles/mixins';

  // ============================================================
  // enjoy-indexページのスタイル
  // ============================================================

  :global(.main-content--enjoy-index) {
    padding-top: spx(110);
    @include tablet-up {
      padding-top: ppx(280 * 1.2);
    }
    @include desktop-up {
      padding-top: ppx(280);
    }
  }

  // ============================================================
  // ヒーローセクション
  // ============================================================

  .enjoy-hero {
    background: linear-gradient(
      135deg,
      var(--blue_2, #e7f3f9) 0%,
      var(--blue_3, #d8edf7) 100%
    );
    padding: spx(80) 0 spx(100);
    text-align: center;
    @include tablet-up {
      padding: ppx(120 * 1.2) 0 ppx(150 * 1.2);
    }
    @include desktop-up {
      padding: ppx(120) 0 ppx(150);
    }

    &__content {
      max-width: spx(640);
      margin: 0 auto;
      padding: 0 spx(20);
      @include tablet-up {
        max-width: ppx(800 * 1.2);
        padding: 0 ppx(40 * 1.2);
      }
      @include desktop-up {
        max-width: ppx(800);
        padding: 0 ppx(40);
      }
    }

    &__title {
      margin-bottom: spx(40);
      @include tablet-up {
        margin-bottom: ppx(60 * 1.2);
      }
      @include desktop-up {
        margin-bottom: ppx(60);
      }

      &-en {
        display: block;
        color: var(--blue_5, #026995);
        font-family: 'Zen Kaku Gothic New';
        font-size: spx(48);
        font-weight: 700;
        letter-spacing: spx(14.4);
        margin-bottom: spx(10);
        @include tablet-up {
          font-size: ppx(60 * 1.2);
          letter-spacing: ppx(18 * 1.2);
          margin-bottom: ppx(15 * 1.2);
        }
        @include desktop-up {
          font-size: ppx(60);
          letter-spacing: ppx(18);
          margin-bottom: ppx(15);
        }
      }

      &-ja {
        display: block;
        color: var(--blue_6, #054965);
        font-family: 'Zen Kaku Gothic New';
        font-size: spx(36);
        font-weight: 400;
        @include tablet-up {
          font-size: ppx(45 * 1.2);
        }
        @include desktop-up {
          font-size: ppx(45);
        }
      }
    }

    &__description {
      color: var(--blue_6, #054965);
      font-family: 'Zen Kaku Gothic New';
      font-size: spx(28);
      font-weight: 400;
      line-height: 1.6;
      @include tablet-up {
        font-size: ppx(32 * 1.2);
      }
      @include desktop-up {
        font-size: ppx(32);
      }
    }
  }

  // ============================================================
  // プラン一覧セクション
  // ============================================================

  .enjoy-plans {
    padding: spx(100) 0 spx(120);
    @include tablet-up {
      padding: ppx(150 * 1.2) 0 ppx(180 * 1.2);
    }
    @include desktop-up {
      padding: ppx(150) 0 ppx(180);
    }

    &__container {
      max-width: spx(640);
      margin: 0 auto;
      padding: 0 spx(20);
      @include tablet-up {
        max-width: ppx(1200 * 1.2);
        padding: 0 ppx(40 * 1.2);
      }
      @include desktop-up {
        max-width: ppx(1200);
        padding: 0 ppx(40);
      }
    }

    &__heading {
      color: var(--blue_6, #054965);
      font-family: 'Zen Kaku Gothic New';
      font-size: spx(42);
      font-weight: 400;
      text-align: center;
      margin-bottom: spx(60);
      @include tablet-up {
        font-size: ppx(50 * 1.2);
        margin-bottom: ppx(80 * 1.2);
      }
      @include desktop-up {
        font-size: ppx(50);
        margin-bottom: ppx(80);
      }
    }

    &__grid {
      display: grid;
      gap: spx(40);
      @include tablet-up {
        grid-template-columns: repeat(2, 1fr);
        gap: ppx(60 * 1.2);
      }
      @include desktop-up {
        gap: ppx(60);
      }
    }
  }

  // ============================================================
  // プランカード
  // ============================================================

  // カードのスタイルは components/ui/EnjoyPlanCards.astro に集約

</style>
