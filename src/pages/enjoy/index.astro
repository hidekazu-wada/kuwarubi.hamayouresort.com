---
// 過ごし方プラン一覧ページ
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import LowerPageHeader from '../../components/ui/LowerPageHeader.astro';
import { allStayPlans } from '../../data/schedules';
import EnjoyPlanCards from '../../components/ui/EnjoyPlanCards.astro';

// カードは TOP と同じ意匠。topPageDisplay（画像・縦書きタイトル）を持つものだけ出す
const cardPlans = allStayPlans
  .filter((plan) => plan.topPageDisplay)
  .sort(
    (a, b) =>
      (a.topPageDisplay?.displayOrder || 0) -
      (b.topPageDisplay?.displayOrder || 0)
  );

// ページ固有のクラス名
const pageClass = 'main-content--enjoy-index';
---

<BaseLayout pageTitle="過ごし方"
  description="スタッフがおすすめする、西湖での過ごし方。お子さま連れ、ご夫婦、何もしない一日、近隣観光、雨の日。5つのプランを時間ごとの流れでご紹介します。" pageClass={pageClass}>
  <!-- ページヘッダー（他の下層ページと共通） -->
  <div class="page-header-container">
    <LowerPageHeader titleEn="ENJOY" titleJa="過ごし方" />
  </div>

  <!-- プラン一覧 -->
  <section class="enjoy-plans">
    {/* カードはTOPと同じ意匠で、右端まで伸びる */}
    <EnjoyPlanCards plans={cardPlans} />
  </section>

  <!-- パンくずリスト -->
  <div class="breadcrumb-wrapper">
    <Breadcrumb items={[{ text: 'TOP', href: '/' }, { text: '過ごし方' }]} />
  </div>
</BaseLayout>

<style lang="scss">
  @import '../../styles/variables';
  @import '../../styles/functions';
  @import '../../styles/mixins';

  // ============================================================
  // enjoy-indexページのスタイル
  // ============================================================

  // 他の下層ページ（FAQ・ACTIVITIES・GUIDE など）と同じ地色・同じ上余白
  :global(.main-content--enjoy-index) {
    background: var(--blue_2, #e7f3f9);
    padding-top: spx(110);
    @include tablet-up {
      padding-top: ppx(280 * 1.2);
    }
    @include desktop-up {
      padding-top: ppx(280);
    }
  }

  // 他ページと同じ左位置（SPは中央寄せなので余白なし）
  .page-header-container {
    @include tablet-up {
      margin-left: ppx(233 * 1.2);
    }
    @include desktop-up {
      margin-left: ppx(233);
    }
  }

  // ============================================================
  // プラン一覧セクション
  // ============================================================

  .enjoy-plans {
    padding: spx(100) 0 spx(120);
    @include tablet-up {
      padding: ppx(150 * 1.2) 0 ppx(180 * 1.2);
    }
    @include desktop-up {
      padding: ppx(150) 0 ppx(180);
    }
  }

  // ============================================================
  // プランカード
  // ============================================================

  // カードのスタイルは components/ui/EnjoyPlanCards.astro に集約

</style>
